{
    "tasks": [
        {
          "label": "Build",
          "type": "shell",
          "command": "make",
          "options": {
              "cwd": "${workspaceFolder}",
              "env": {
                "DEVKITPRO": "/opt/devkitpro",
                "DEVKITARM": "/opt/devkitpro/devkitARM"
              }
          },
          "group": {
              "kind": "build",
              "isDefault": true
          },
          "presentation": {
              "panel": "shared",
              "clear": true
          }
        },
        {
            // "label": "clean",
            "label": "altTask",
            "type": "shell",
            "command": "make",
            "args": [
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                  "DEVKITPRO": "/opt/devkitpro",
                  "DEVKITARM": "/opt/devkitpro/devkitARM"
                }
            },
            "presentation": {
                "panel": "shared",
                "clear": true
            }
        },
        {
            // "label":"link",
            "label":"shiftTask",
            "type":"shell",
            "command": "/opt/devkitpro/tools/bin/3dslink",
            "args": [
                "-a",
                "10.60.188.143",
                "${workspaceFolderBasename}.3dsx"
                // gdb-multiarch ${workspaceFolderBasename}.elf -ex 'target remote 10.60.188.143:4000'
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "panel": "shared",
                "clear": true
            }
        }
    ],
    "version": "2.0.0"
}